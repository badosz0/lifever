{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lifever-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "observability": {
    "enabled": true,
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "replace-with-your-hyperdrive-id",
      "localConnectionString": "postgresql://lifever:lifever@localhost:5432/lifever?schema=public",
    },
  ],
}
