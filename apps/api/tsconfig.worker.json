{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "src/app.ts",
    "src/worker.ts",
    "src/config/env.ts",
    "src/db/types.ts",
    "src/db/worker-client.ts",
    "src/modules/**/*.ts",
    "src/generated/prisma/**/*.ts",
    "src/generated/prisma-d1/**/*.ts"
  ],
  "exclude": ["src/index.ts", "src/config/node-env.ts", "src/db/client.ts"]
}
