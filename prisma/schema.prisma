generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                       String                    @id
  name                     String
  email                    String                    @unique
  emailVerified            Boolean                   @default(false)
  image                    String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  sessions                 Session[]
  accounts                 Account[]
  lists                    ReminderList[]
  reminders                Reminder[]
  calendars                LifeverCalendar[]
  calendarEvents           CalendarEvent[]
  calendarCategories       CalendarCategory[]
  googleCalendarConnection GoogleCalendarConnection?
  googleCalendars          GoogleCalendar[]
  notes                    Note[]
  noteCategories           NoteCategory[]
  notesSettings            NotesSettings?
  kanbanWorkspace          KanbanWorkspace?
  kanbanProjects           KanbanProject[]
  ownedResourceShares      ResourceShare[]          @relation("ResourceShareOwner")
  resourceShares           ResourceShare[]          @relation("ResourceShareMember")
  sentResourceInvites      ResourceInvite[]         @relation("ResourceInviteOwner")
  receivedResourceInvites  ResourceInvite[]         @relation("ResourceInviteRecipient")
  preferences              UserPreferences?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

model ReminderList {
  id        String     @id @default(cuid())
  name      String
  color     String     @default("blue")
  icon      String     @default("list")
  position  Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders Reminder[]

  @@index([userId, position])
  @@map("reminder_list")
}

model Reminder {
  id          String        @id @default(cuid())
  title       String
  notes       String?
  dueAt       DateTime?
  completedAt DateTime?
  important   Boolean       @default(false)
  repeatRule  String?
  position    Float         @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  listId      String?
  list        ReminderList? @relation(fields: [listId], references: [id], onDelete: SetNull)

  @@index([userId, completedAt])
  @@index([userId, dueAt])
  @@index([listId, position])
  @@map("reminder")
}

model CalendarEvent {
  id            String           @id @default(cuid())
  title         String
  startAt       DateTime
  endAt         DateTime
  location      String           @default("")
  notes         String           @default("")
  color         String?
  alertsEnabled Boolean          @default(true)
  allDay        Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId    String
  category      CalendarCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  calendarId    String
  calendar      LifeverCalendar  @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
  @@index([categoryId])
  @@index([calendarId, startAt])
  @@map("calendar_event")
}

model LifeverCalendar {
  id         String             @id @default(cuid())
  name       String
  color      String
  position   Int                @default(0)
  visible    Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  events     CalendarEvent[]
  categories CalendarCategory[]

  @@index([userId, position])
  @@map("lifever_calendar")
}

model CalendarCategory {
  id         String          @id @default(cuid())
  name       String
  color      String
  position   Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarId String
  calendar   LifeverCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  events     CalendarEvent[]

  @@index([calendarId, position])
  @@map("calendar_category")
}

model GoogleCalendarConnection {
  userId                String    @id
  encryptedRefreshToken String
  calendarListSyncedAt  DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_calendar_connection")
}

model GoogleCalendar {
  id         String   @id @default(cuid())
  googleId   String
  name       String
  color      String
  accessRole String
  primary    Boolean  @default(false)
  visible    Boolean  @default(true)
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, googleId])
  @@index([userId, position])
  @@map("google_calendar")
}

model Note {
  id         String       @id
  title      String       @default("")
  body       String       @default("")
  pinned     Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   NoteCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, updatedAt])
  @@index([categoryId])
  @@map("note")
}

model NoteCategory {
  id        String   @id
  name      String
  color     String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes     Note[]

  @@index([userId, position])
  @@map("note_category")
}

model NotesSettings {
  userId            String   @id
  sort              String   @default("updated")
  previewLines      Int      @default(2)
  defaultCategoryId String
  openInPreview     Boolean  @default(false)
  spellcheck        Boolean  @default(true)
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notes_settings")
}

model KanbanWorkspace {
  userId    String   @id
  state     Json
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kanban_workspace")
}

model KanbanProject {
  id        String   @id
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, updatedAt])
  @@map("kanban_project")
}

model ResourceShare {
  id           String   @id @default(cuid())
  resourceType String
  resourceId   String
  permission   String
  visible      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  ownerId      String
  owner        User     @relation("ResourceShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation("ResourceShareMember", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceType, resourceId, userId])
  @@index([ownerId, resourceType])
  @@index([userId, resourceType])
  @@map("resource_share")
}

model ResourceInvite {
  id           String    @id @default(cuid())
  resourceType String
  resourceId   String
  resourceName String
  email        String
  permission   String
  status       String    @default("pending")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  ownerId      String
  owner        User      @relation("ResourceInviteOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  recipientId  String?
  recipient    User?     @relation("ResourceInviteRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  @@unique([resourceType, resourceId, email])
  @@index([email, status, createdAt])
  @@index([ownerId, resourceType, resourceId])
  @@map("resource_invite")
}

model UserPreferences {
  userId                      String   @id
  theme                       String   @default("system")
  timeFormat                  String   @default("system")
  dateFormat                  String   @default("system")
  calendarClickToCreate       Boolean  @default(true)
  calendarSourceConfiguration Json     @default("{}")
  appConfiguration            Json     @default("{}")
  favoriteDriverId            String?
  favoriteConstructorId       String?
  updatedAt                   DateTime @updatedAt
  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}
